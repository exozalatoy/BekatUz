# ---- Backend ----
ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# SQLite for local dev (no Docker). In Docker compose overrides this with Postgres.
DATABASE_URL=sqlite:///./bekatuz.db
# DATABASE_URL=postgresql+psycopg://bekatuz:bekatuz@db:5432/bekatuz

REDIS_URL=redis://localhost:6379/0

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Telegram bot (optional in dev — codes are logged to console)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=bekatuzz_bot
TELEGRAM_CHAT_ID=

